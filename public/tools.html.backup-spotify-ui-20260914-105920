<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Tools - JAVIN SEMOK</title>
<link rel="stylesheet" href="style.css" />
</head>
<body>
<div class="page tools-page">
  <header class="page-header">
    <a href="/" class="header-btn">Home</a>
    <h1>🧰 Tools</h1>
  </header>
  <div class="page-content tools-content">
    <div class="tools-hero">
      <div class="tools-hero-icon">🚀</div>
      <div class="tools-hero-title">AI & Utility Tools</div>
      <div class="tools-hero-sub">Kumpulan tools buat lo pake sehari-hari</div>
    </div>

    
<div class="javin-spotify-box">
  <div class="javin-spotify-heading">
    <div class="javin-spotify-icon">🎵</div>

    <div>
      <div class="javin-spotify-title-main">
        Spotify Downloader
      </div>

      <div class="javin-spotify-subtitle">
        Cari dan putar lagu
      </div>
    </div>
  </div>

  <div class="javin-spotify-search">
    <input
      id="javinSpotifyQuery"
      type="text"
      placeholder="Masukkan judul lagu..."
      autocomplete="off"
    />

    <button
      id="javinSpotifySearch"
      type="button"
    >
      Cari
    </button>
  </div>

  <div
    id="javinSpotifyStatus"
    class="javin-spotify-status"
  ></div>

  <div id="javinSpotifyResult"></div>
</div>

<script>
(function () {
  const input = document.getElementById('javinSpotifyQuery');
  const button = document.getElementById('javinSpotifySearch');
  const status = document.getElementById('javinSpotifyStatus');
  const result = document.getElementById('javinSpotifyResult');

  if (!input || !button || !status || !result) return;

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, function (char) {
      return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      }[char];
    });
  }

  async function searchSpotify() {
    const q = input.value.trim();

    if (!q) {
      status.textContent = '⚠️ Masukkan judul lagu terlebih dahulu.';
      result.innerHTML = '';
      return;
    }

    button.disabled = true;
    status.textContent = '🔎 Mencari lagu...';
    result.innerHTML = '';

    try {
      const response = await fetch(
        '/api/spotifyplay?q=' + encodeURIComponent(q),
        {
          method: 'GET',
          headers: {
            'Accept': 'application/json'
          }
        }
      );

      const data = await response.json();

      if (!response.ok || !data || data.status !== true || !data.result) {
        throw new Error(
          data && data.error
            ? data.error
            : 'Lagu tidak ditemukan.'
        );
      }

      const song = data.result;

      const title = song.title || q;
      const artist = song.artist || 'Unknown Artist';
      const duration = song.duration || '';
      const thumbnail = song.thumbnail || '';
      const audioUrl = song.download_url || '';

      if (!audioUrl) {
        throw new Error('Audio lagu tidak tersedia.');
      }

      result.innerHTML = `
        <div class="javin-spotify-card">

          ${
            thumbnail
              ? `
                <img
                  class="javin-spotify-cover"
                  src="${escapeHtml(thumbnail)}"
                  alt="${escapeHtml(title)}"
                  loading="lazy"
                />
              `
              : ''
          }

          <div class="javin-spotify-info">

            <div class="javin-spotify-song">
              ${escapeHtml(title)}
            </div>

            <div class="javin-spotify-artist">
              ${escapeHtml(artist)}
            </div>

            ${
              duration
                ? `
                  <div class="javin-spotify-duration">
                    ⏱️ ${escapeHtml(duration)}
                  </div>
                `
                : ''
            }

            <audio
              id="javinSpotifyAudio"
              preload="none"
              controls
              src="${escapeHtml(audioUrl)}"
            ></audio>

            <div class="javin-spotify-controls">

              <button
                type="button"
                id="javinSpotifyPlay"
                class="javin-spotify-control"
              >
                ▶️ Play
              </button>

              <button
                type="button"
                id="javinSpotifyPause"
                class="javin-spotify-control"
              >
                ⏸️ Pause
              </button>

              <a
                id="javinSpotifyDownload"
                class="javin-spotify-control javin-spotify-download"
                href="${escapeHtml(audioUrl)}"
                target="_blank"
                rel="noopener noreferrer"
              >
                📥 Download
              </a>

            </div>

          </div>
        </div>
      `;

      const audio = document.getElementById('javinSpotifyAudio');
      const play = document.getElementById('javinSpotifyPlay');
      const pause = document.getElementById('javinSpotifyPause');

      if (audio && play) {
        play.addEventListener('click', function () {
          audio.play().catch(function () {
            status.textContent =
              '⚠️ Audio tidak bisa diputar di browser.';
          });
        });
      }

      if (audio && pause) {
        pause.addEventListener('click', function () {
          audio.pause();
        });
      }

      status.textContent = '✅ Lagu ditemukan.';

    } catch (error) {
      console.error('Spotify error:', error);

      status.textContent =
        '❌ ' + (error.message || 'Gagal mencari lagu.');

      result.innerHTML = '';
    } finally {
      button.disabled = false;
    }
  }

  button.addEventListener('click', searchSpotify);

  input.addEventListener('keydown', function (event) {
    if (event.key === 'Enter') {
      event.preventDefault();
      searchSpotify();
    }
  });
})();
</script>

<div class="tools-grid">
      <a href="/llama.html" class="tool-card">
        <div class="tool-icon">🤖</div>
        <div class="tool-name">Asisten Javin</div>
        <div class="tool-desc">Chat sama AI assistant</div>
        <div class="tool-badge">AI CHAT</div>
      </a>
      <a href="/qr.html" class="tool-card"><div class="tool-icon">📱</div><div class="tool-name">QR Generator</div><div class="tool-desc">Bikin QR code dari link / teks</div><div class="tool-badge">UTILITY</div></a>
      <a href="/brat.html" class="tool-card"><div class="tool-icon">💚</div><div class="tool-name">Brat Video</div><div class="tool-desc">Bikin video brat dari teks</div><div class="tool-badge">VIDEO</div></a>
            <div class="tool-card tool-soon">
        <div class="tool-icon">✨</div>
        <div class="tool-name">Coming Soon</div>
        <div class="tool-desc">Tools baru segera hadir</div>
        <div class="tool-badge tool-badge-soon">SOON</div>
      </div>
    </div>

    <div class="tools-footer">
      <p>Tools bertambah tiap ada update ✨</p>
    </div>
  </div>
</div>
<script src="common.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="auth-socket.js"></script>
</body>
</html>

<div class="javin-spotify-box" id="javinSpotifyBox">
  <div class="javin-spotify-heading">
    <div class="javin-spotify-icon">🎵</div>

    <div>
      <div class="javin-spotify-title-main">
        Spotify
      </div>

      <div class="javin-spotify-subtitle">
        Cari dan dengarkan lagu anda
      </div>
      <div class="javin-spotify-category">
        Musik
      </div>
    </div>
  </div>

  <div class="javin-spotify-search">
    <input
      id="javinSpotifyQuery"
      type="text"
      placeholder="Masukkan judul lagu..."
      autocomplete="off"
    />

    <button
      id="javinSpotifySearch"
      type="button"
    >
      Cari
    </button>
  </div>

  <div
    id="javinSpotifyStatus"
    class="javin-spotify-status"
  ></div>

  <div id="javinSpotifyResult"></div>
</div>

<script>
(function () {
  const input = document.getElementById('javinSpotifyQuery');
  const button = document.getElementById('javinSpotifySearch');
  const status = document.getElementById('javinSpotifyStatus');
  const result = document.getElementById('javinSpotifyResult');

  if (!input || !button || !status || !result) return;

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, function (char) {
      return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      }[char];
    });
  }

  async function searchSpotify() {
    const q = input.value.trim();

    if (!q) {
      status.textContent = 'Masukkan judul lagu terlebih dahulu.';
      result.innerHTML = '';
      return;
    }

    button.disabled = true;
    status.textContent = 'Mencari lagu...';
    result.innerHTML = '';

    try {
      const response = await fetch(
        '/api/spotifyplay?q=' +
        encodeURIComponent(q),
        {
          headers: {
            'Accept': 'application/json'
          }
        }
      );

      const data = await response.json();

      if (
        !response.ok ||
        !data ||
        data.status !== true ||
        !data.result
      ) {
        throw new Error(
          data?.error || 'Lagu tidak ditemukan.'
        );
      }

      const song = data.result;

      const title =
        song.title || q;

      const artist =
        song.artist || 'Unknown Artist';

      const duration =
        song.duration || '';

      const thumbnail =
        song.thumbnail || '';

      const audioUrl =
        song.download_url || '';

      if (!audioUrl) {
        throw new Error(
          'Audio lagu tidak tersedia.'
        );
      }

      const proxyUrl =
        '/api/spotify/audio?url=' +
        encodeURIComponent(audioUrl);

      result.innerHTML = `
        <div class="javin-tool-result-card">

          <div class="javin-tool-result-media">
            ${
              thumbnail
                ? `
                  <img
                    src="${escapeHtml(thumbnail)}"
                    alt="${escapeHtml(title)}"
                    loading="lazy"
                  >
                `
                : `
                  <div class="javin-tool-result-placeholder">
                    🎵
                  </div>
                `
            }
          </div>

          <div class="javin-tool-result-body">

            <div class="javin-tool-result-label">
              SPOTIFY
            </div>

            <div class="javin-tool-result-title">
              ${escapeHtml(title)}
            </div>

            <div class="javin-tool-result-subtitle">
              ${escapeHtml(artist)}
            </div>

            ${
              duration
                ? `
                  <div class="javin-tool-result-meta">
                    ⏱ ${escapeHtml(duration)}
                  </div>
                `
                : ''
            }

            <audio
              id="javinSpotifyAudio"
              preload="none"
              controls
              src="${escapeHtml(proxyUrl)}"
            ></audio>

            <div class="javin-tool-result-actions">

              <button
                type="button"
                id="javinSpotifyPlay"
                class="javin-tool-action"
              >
                ▶️ Play
              </button>

              <button
                type="button"
                id="javinSpotifyPause"
                class="javin-tool-action"
              >
                ⏸️ Pause
              </button>

              <a
                id="javinSpotifyDownload"
                class="javin-tool-action"
                href="${escapeHtml(proxyUrl)}"
                download
              >
                📥 Download
              </a>

            </div>

          </div>
        </div>
      `;

      const audio =
        document.getElementById(
          'javinSpotifyAudio'
        );

      const play =
        document.getElementById(
          'javinSpotifyPlay'
        );

      const pause =
        document.getElementById(
          'javinSpotifyPause'
        );

      if (audio && play) {
        play.addEventListener(
          'click',
          async function () {
            try {
              status.textContent =
                '▶️ Memuat audio...';

              await audio.play();

              status.textContent =
                '🎵 Sedang diputar';
            } catch (err) {
              console.error(
                'Spotify play error:',
                err
              );

              status.textContent =
                '❌ Audio tidak dapat diputar.';
            }
          }
        );
      }

      if (audio && pause) {
        pause.addEventListener(
          'click',
          function () {
            audio.pause();

            status.textContent =
              '⏸️ Audio dijeda';
          }
        );
      }

      if (audio) {
        audio.addEventListener(
          'ended',
          function () {
            status.textContent =
              '✅ Lagu selesai.';
          }
        );

        audio.addEventListener(
          'error',
          function () {
            status.textContent =
              '❌ Gagal memuat audio.';
          }
        );
      }

      status.textContent =
        '✅ Lagu ditemukan.';

    } catch (error) {
      console.error(
        'Spotify error:',
        error
      );

      status.textContent =
        '❌ ' +
        (error.message ||
          'Gagal mencari lagu.');

      result.innerHTML = '';

    } finally {
      button.disabled = false;
    }
  }

  button.addEventListener(
    'click',
    searchSpotify
  );

  input.addEventListener(
    'keydown',
    function (event) {
      if (event.key === 'Enter') {
        event.preventDefault();
        searchSpotify();
      }
    }
  );
})();
</script>

